{
  "name": "vision-forge",
  "version": "1.0.0",
  "description": "Vision Forge — AI Image & Video Studio (Node.js + React)",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"API,UI\" --prefix-colors \"cyan,magenta\" \"node --watch server/index.js\" \"npm run dev --prefix frontend\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix frontend",
    "postinstall": "npm install --prefix frontend",
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "start": "node server/index.js",
    "install:all": "npm install && npm install --prefix frontend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "replicate": "^0.32.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
